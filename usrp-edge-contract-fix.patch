+    applicationId: requireApplicationId(row, 'listAmberQueue'),
+    processingCode: str(get(row, 'processingCode')),
+    status: optionalStatus(get(row, 'status'), 'listAmberQueue'),
+    documentType: str(get(row, 'documentType')),
