{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USRP UI surface contract",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "audience", "owner", "purpose", "routes", "operations", "ads", "states", "accessibility", "tests", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "enum": ["citizen", "officer", "field-officer", "shared"] },
    "owner": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "routes": { "type": "array", "minItems": 1 },
    "operations": { "type": "array", "items": { "type": "string" } },
    "ads": { "type": "array", "minItems": 1 },
    "states": { "type": "array", "minItems": 1 },
    "accessibility": { "type": "array", "minItems": 1 },
    "tests": { "type": "array", "minItems": 1 },
    "rules": { "type": "object" }
  }
}
