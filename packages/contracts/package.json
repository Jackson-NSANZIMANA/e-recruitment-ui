{
  "name": "@usrp/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "USRP API contracts — OpenAPI 3.1 documents hand-authored from backend source, generated Zod schemas and types, the per-agency divergence model, and the drift machinery. The only legal source of domain types in this frontend.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agency": "./src/agency.ts",
    "./narrow": "./src/narrow.ts",
    "./generated": "./src/generated/index.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "verify": "tsx scripts/verify.ts",
    "drift": "tsx ../../tooling/contract-drift/src/cli.ts",
    "drift:selftest": "tsx ../../tooling/contract-drift/src/selftest.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.src.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@usrp/eslint-config": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "~5.4.0"
  }
}
