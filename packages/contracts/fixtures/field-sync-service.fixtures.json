{
  "service": "field-sync-service",
  "cases": [
    { "id": "synced-all-rejected", "schema": "SyncScoresOk", "expect": "accept",
      "why": "THE MOST DANGEROUS SHAPE IN THE PLATFORM: status is SYNCED even though every record was REJECTED for BAD_SIGNATURE. A single success toast over this response tells a field officer their exam-day scores are saved when none of them are.",
      "value": { "status": "SYNCED", "results": [ { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "outcome": "REJECTED", "reason": "BAD_SIGNATURE" } ] } },
    { "id": "synced-mixed", "schema": "SyncScoresOk", "expect": "accept",
      "why": "Partial acceptance. The per-record array is the only place the truth lives.",
      "value": { "status": "SYNCED", "results": [ { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "outcome": "ACCEPTED" }, { "applicationId": "b4e2d3c5-6f71-4a82-93a4-1b2c3d4e5f60", "outcome": "REJECTED", "reason": "BAD_SIGNATURE" } ] } },
    { "id": "synced-rejects-other-status", "schema": "SyncScoresOk", "expect": "reject",
      "why": "There is no PARTIAL and no FAILED. The controller emits one literal.",
      "value": { "status": "PARTIAL", "results": [] } },
    { "id": "score-record", "schema": "FieldScoreRecord", "expect": "accept",
      "why": "parseRecord, transcribed. Every metric required and finite.",
      "value": { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "qrInvitationCode": "QR-778", "metrics": { "heightCm": 176, "weightKg": 68.4, "run3kmTimeSeconds": 742, "chestCm": 92, "medicalFitnessStatus": "FIT" }, "capturedAt": "2026-08-20T06:31:00.000Z", "deviceId": "tab-014", "capturingOfficerId": "off-221", "vectorClock": { "tab-014": 7 }, "deviceSignature": "sig", "signedPayloadHash": "hash" } },
    { "id": "score-record-lax-captured-at", "schema": "FieldScoreRecord", "expect": "accept",
      "why": "capturedAt is typed string and NOT date-time: the controller only checks it is a non-empty string. Documenting a format the service does not enforce would be a guess, so an offline tablet's local stamp passes.",
      "value": { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "qrInvitationCode": "QR-778", "metrics": { "heightCm": 176, "weightKg": 68.4, "run3kmTimeSeconds": 742, "chestCm": 92, "medicalFitnessStatus": "PENDING_REVIEW", "additionalNotes": "knee strapping" }, "capturedAt": "20/08/2026 08:31 CAT", "deviceId": "tab-014", "capturingOfficerId": "off-221", "vectorClock": { "tab-014": 7 }, "deviceSignature": "sig", "signedPayloadHash": "hash" } },
    { "id": "score-record-rejects-bad-fitness", "schema": "FieldScoreRecord", "expect": "reject",
      "why": "FIT | UNFIT | PENDING_REVIEW only — and note this is a DIFFERENT set from the medical-review transition's FIT | UNFIT.",
      "value": { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "qrInvitationCode": "QR-778", "metrics": { "heightCm": 176, "weightKg": 68, "run3kmTimeSeconds": 742, "chestCm": 92, "medicalFitnessStatus": "MARGINAL" }, "capturedAt": "x", "deviceId": "d", "capturingOfficerId": "o", "vectorClock": {}, "deviceSignature": "s", "signedPayloadHash": "h" } },
    { "id": "score-record-rejects-missing-signature", "schema": "FieldScoreRecord", "expect": "reject",
      "why": "The device signature is the integrity gate. An unsigned record is a whole-batch 400.",
      "value": { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "qrInvitationCode": "QR-778", "metrics": { "heightCm": 176, "weightKg": 68, "run3kmTimeSeconds": 742, "chestCm": 92, "medicalFitnessStatus": "FIT" }, "capturedAt": "x", "deviceId": "d", "capturingOfficerId": "o", "vectorClock": {}, "signedPayloadHash": "h" } },
    { "id": "batch-rejects-empty", "schema": "SyncScoresRequest", "expect": "reject",
      "why": "400 INVALID_BATCH: records must be a NON-EMPTY array.",
      "value": { "records": [] } },
    { "id": "device-enrolled", "schema": "DeviceEnrolled201", "expect": "accept",
      "why": "201 on first enrollment, bound to the caller's agency.",
      "value": { "status": "ENROLLED", "deviceId": "tab-014", "agency": "RDF" } },
    { "id": "device-already-enrolled", "schema": "DeviceAlreadyEnrolled200", "expect": "accept",
      "why": "200 on replay, and agency is the EXISTING binding — which may not be the caller's. The only signal a client gets that a device belongs to a sibling agency.",
      "value": { "status": "ALREADY_ENROLLED", "deviceId": "tab-014", "agency": "RNP" } },
    { "id": "enroll-rejects-private-key", "schema": "EnrollDeviceRequest", "expect": "reject",
      "why": "The device's PRIVATE key never touches the server. Only publicKeyPem is submitted.",
      "value": { "deviceId": "tab-014", "publicKeyPem": "-----BEGIN PUBLIC KEY-----", "privateKeyPem": "-----BEGIN PRIVATE KEY-----" } },
    { "id": "conflict-resolved", "schema": "ConflictResolved200", "expect": "accept",
      "why": "resolve-conflict RESOLVED branch. Echoes both ids so the tablet can reconcile which row it selected; the application advances after this.",
      "value": { "status": "RESOLVED", "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "scoreId": "b4e2d3c5-6f71-4a82-93a4-1b2c3d4e5f60" } },
    { "id": "resolve-404-application", "schema": "ResolveNotFound404", "expect": "accept",
      "why": "TWO DISTINCT 404s. This one: no such application in the caller's agency.",
      "value": { "status": "NOT_FOUND" } },
    { "id": "resolve-404-score", "schema": "ResolveNotFound404", "expect": "accept",
      "why": "This one: the application exists, the chosen scoreId does not. Collapsing them tells the officer the wrong thing about which id was wrong.",
      "value": { "status": "SCORE_NOT_FOUND" } },
    { "id": "resolve-request-caps-resolution", "schema": "ResolveConflictRequest", "expect": "reject",
      "why": "resolution is capped at 50 chars server-side. A free-text box with no maxLength produces a 400 the officer cannot see coming.",
      "value": { "applicationId": "a3f1c2d4-5b6e-4f70-8192-0a1b2c3d4e5f", "scoreId": "b4e2d3c5-6f71-4a82-93a4-1b2c3d4e5f60", "resolution": "Selected the second capture because the first tablet had a stale vector clock and the officer re-ran it" } }
  ]
}
