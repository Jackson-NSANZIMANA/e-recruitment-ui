{
  "service": "iam-service",
  "cases": [
    {
      "id": "token-issued",
      "schema": "TokenIssued",
      "expect": "accept",
      "why": "officer-login and service-token success. TWO FIELDS. This is the shape, not an abridgement of it.",
      "value": {
        "token": "eyJhbGciOiJFZDI1NTE5In0.eyJzdWIiOiIxIn0.sig",
        "expiresAt": "2026-08-27T09:44:00.000Z"
      }
    },
    {
      "id": "token-rejects-user-object",
      "schema": "TokenIssued",
      "expect": "reject",
      "why": "THE CENTRAL IAM GAP, pinned as a fixture. Login returns no user, no agency, no roles. A console that expects them here is expecting an endpoint that does not exist (GET /v1/auth/officer/me is proposed, not built).",
      "value": {
        "token": "t",
        "expiresAt": "2026-08-27T09:44:00.000Z",
        "user": {
          "id": "1",
          "agency": "RDF",
          "roles": [
            "REVIEWER"
          ]
        }
      }
    },
    {
      "id": "token-rejects-refresh",
      "schema": "TokenIssued",
      "expect": "reject",
      "why": "There is no refresh token and no refresh endpoint. An officer token is valid until it expires, by design (ADR-016); the UI re-authenticates.",
      "value": {
        "token": "t",
        "expiresAt": "2026-08-27T09:44:00.000Z",
        "refreshToken": "r"
      }
    },
    {
      "id": "invalid-credentials",
      "schema": "InvalidCredentials401",
      "expect": "accept",
      "why": "One shape for unknown handle, wrong password AND disabled account. No enumeration.",
      "value": {
        "error": "INVALID_CREDENTIALS",
        "detail": "Invalid handle or password."
      }
    },
    {
      "id": "credentials-rejects-client-code",
      "schema": "InvalidCredentials401",
      "expect": "reject",
      "why": "The two grants have DIFFERENT 401 codes. INVALID_CLIENT belongs to the service-token route.",
      "value": {
        "error": "INVALID_CLIENT"
      }
    },
    {
      "id": "invalid-client",
      "schema": "InvalidClient401",
      "expect": "accept",
      "why": "service-token 401. Unknown client, wrong secret and disabled client are one shape here too — the enumeration discipline is identical to login.",
      "value": {
        "error": "INVALID_CLIENT",
        "detail": "Invalid client id or secret."
      }
    },
    {
      "id": "login-request",
      "schema": "OfficerLoginRequest",
      "expect": "accept",
      "why": "Both fields required, bounded 128 / 256.",
      "value": {
        "loginHandle": "j.nsanzimana",
        "password": "correct-horse-battery-staple"
      }
    },
    {
      "id": "login-request-rejects-email-field",
      "schema": "OfficerLoginRequest",
      "expect": "reject",
      "why": "The field is loginHandle, not email or username. A login form bound to the wrong name is a 400 on every submit.",
      "value": {
        "email": "j@rdf.gov.rw",
        "password": "x"
      }
    },
    {
      "id": "login-request-rejects-empty-handle",
      "schema": "OfficerLoginRequest",
      "expect": "reject",
      "why": "Controller checks length === 0 before anything else. Empty is a 400, not an auth failure.",
      "value": {
        "loginHandle": "",
        "password": "x"
      }
    },
    {
      "id": "invalid-request-400",
      "schema": "InvalidRequest400",
      "expect": "accept",
      "why": "Shape error. Deliberately NOT a signal about whether the handle exists.",
      "value": {
        "error": "INVALID_REQUEST",
        "detail": "Field \"loginHandle\" is required."
      }
    },
