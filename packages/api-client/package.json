{
  "name": "@usrp/api-client",
  "version": "2.0.0",
  "private": true,
  "description": "Typed client and TanStack Query hooks for the USRP edge — paths validated against @usrp/contracts, exact-path only, typed error normalisation over the real discriminated error bodies.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "scripts": {
    "lint": "node scripts/lint-api-client.mjs",
    "typecheck": "tsc --noEmit",
    "check:paths": "tsx scripts/check-exact-paths.ts",
    "test": "node scripts/test.mjs",
    "selfcheck": "tsx selfcheck/verify-api-client.ts",
    "verify": "pnpm run check:paths && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check": "pnpm run verify",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@tanstack/react-query": "5.56.2",
    "@usrp/contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.4.0"
  }
}
