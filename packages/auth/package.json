{
  "name": "@usrp/auth",
  "version": "2.0.0",
  "private": true,
  "description": "Session model, officer login, citizen OTP flow and route guards for USRP — built on the credentials that exist (ADR-016 officer Ed25519 JWT, ADR-018 opaque revocable citizen session), fronted by the edge session cookie.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selfcheck": "tsx selfcheck/verify-auth.ts",
    "verify": "pnpm run selfcheck",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "dependencies": {
    "@usrp/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react-router-dom": "6.26.2",
    "tsx": "^4.19.0",
    "typescript": "~5.4.0"
  }
}
