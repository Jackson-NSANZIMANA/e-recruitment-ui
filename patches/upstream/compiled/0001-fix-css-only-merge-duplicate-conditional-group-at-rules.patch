 packages/css/src/__tests__/sort.test.ts       | 22 +++++++++++++
 .../merge-duplicate-at-rules.test.ts          | 32 +++++++++++++++++++
 .../src/plugins/merge-duplicate-at-rules.ts   | 12 +++++++
