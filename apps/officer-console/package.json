{
  "name": "@usrp/officer-console",
  "version": "1.0.0",
  "private": true,
  "description": "USRP officer-facing console (RDF / RNP / RCS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude e2e/**",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan:cssmap": "node ../../packages/ui/scripts/scan-cssmap.cjs src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@atlaskit/app-provider": "^5.3.0",
    "@atlaskit/button": "^25.0.2",
    "@atlaskit/css": "^1.0.0",
    "@atlaskit/css-reset": "^8.1.2",
    "@atlaskit/dynamic-table": "^19.1.5",
    "@atlaskit/flag": "^18.2.11",
    "@atlaskit/form": "^16.1.5",
    "@atlaskit/heading": "^7.0.1",
    "@atlaskit/icon": "^37.3.0",
    "@atlaskit/logo": "^21.4.3",
    "@atlaskit/modal-dialog": "^16.3.0",
    "@atlaskit/navigation-system": "^10.11.1",
    "@atlaskit/page-header": "^13.1.3",
    "@atlaskit/platform-feature-flags": "^2.1.1",
    "@atlaskit/primitives": "^22.2.1",
    "@atlaskit/section-message": "^10.0.0",
    "@atlaskit/side-nav-items": "^2.3.10",
    "@atlaskit/spinner": "^20.1.2",
    "@atlaskit/textfield": "^10.0.1",
    "@atlaskit/tokens": "^16.4.0",
    "@compiled/react": "^1.0.0",
    "@tanstack/react-query": "5.56.2",
    "@usrp/api-client": "workspace:*",
    "@usrp/auth": "workspace:*",
    "@usrp/i18n": "workspace:*",
    "@usrp/shared-types": "workspace:*",
    "@usrp/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.26.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@atlaskit/eslint-plugin-design-system": "^16.10.0",
    "@compiled/babel-plugin": "^2.0.0",
    "@compiled/babel-plugin-strip-runtime": "^2.0.0",
    "@playwright/test": "^1.47.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@usrp/eslint-config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.9.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
