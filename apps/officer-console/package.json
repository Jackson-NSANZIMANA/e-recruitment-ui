{
  "name": "@usrp/officer-console",
  "version": "1.0.0",
  "private": true,
  "description": "USRP officer-facing console and field-tablet application (RDF / RNP / RCS)",
  "license": "UNLICENSED",
  "type": "module",
  "//dependencies": "@usrp/feature-applications owns the flagship officer application workspace. The host route adapters inject the shared edge client and authenticated agency; the remaining feature routes stay in the slice mount table.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude=**/e2e/** --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan:cssmap": "node ../../packages/ui/scripts/scan-cssmap.cjs src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@atlaskit/app-provider": "^8.1.0",
    "@atlaskit/button": "^25.0.2",
    "@atlaskit/css": "^1.0.0",
    "@atlaskit/css-reset": "^8.1.2",
    "@atlaskit/dynamic-table": "^19.1.5",
    "@atlaskit/flag": "^18.2.11",
    "@atlaskit/form": "^16.1.5",
    "@atlaskit/heading": "^7.0.1",
    "@atlaskit/icon": "^37.3.0",
    "@atlaskit/lozenge": "^15.0.1",
    "@atlaskit/logo": "^21.4.3",
    "@atlaskit/modal-dialog": "^16.3.0",
    "@atlaskit/navigation-system": "^10.11.1",
    "@atlaskit/page-header": "^13.1.3",
    "@atlaskit/platform-feature-flags": "^2.1.1",
    "@atlaskit/primitives": "^22.2.1",
    "@atlaskit/section-message": "^10.0.0",
    "@atlaskit/select": "^21.0.0",
    "@atlaskit/side-nav-items": "^2.3.10",
    "@atlaskit/spinner": "^20.1.2",
    "@atlaskit/textfield": "^10.0.1",
    "@atlaskit/tokens": "^16.4.0",
    "@compiled/react": "^1.0.0",
    "@tanstack/react-query": "5.56.2",
    "@usrp/api-client": "workspace:*",
    "@usrp/auth": "workspace:*",
    "@usrp/contracts": "workspace:*",
    "@usrp/design-system": "workspace:^",
    "@usrp/feature-adjudication": "workspace:*",
    "@usrp/feature-applications": "workspace:*",
    "@usrp/feature-campaigns": "workspace:*",
    "@usrp/feature-compliance": "workspace:*",
    "@usrp/feature-identity": "workspace:*",
    "@usrp/feature-scheduling": "workspace:*",
    "@usrp/i18n": "workspace:*",
    "@usrp/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.30.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
