{
  "name": "@usrp/field-station",
  "version": "1.0.0",
  "private": true,
  "description": "USRP Field Station: the managed exam-day tablet PWA (gate, walk-in, and the stations S08 fills). RDF / RNP / RCS.",
  "license": "UNLICENSED",
  "type": "module",
  "//dependencies": "Composes ONLY @usrp/feature-identity, @usrp/feature-scheduling, @usrp/feature-field-ops and the @usrp/feature-applications model (ADR-FE-007); tooling/repo-hygiene/check-boundaries.mjs fails on any other slice. The app owns routing, the shell, the PWA manifest and auth boot; the stations are feature code.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude=**/e2e/** --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan:cssmap": "node ../../packages/ui/scripts/scan-cssmap.cjs src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@atlaskit/app-provider": "^8.1.0",
    "@atlaskit/button": "^25.0.2",
    "@atlaskit/css": "^1.0.0",
    "@atlaskit/css-reset": "^8.1.2",
    "@atlaskit/flag": "^18.2.11",
    "@atlaskit/heading": "^7.0.1",
    "@atlaskit/lozenge": "^15.0.1",
    "@atlaskit/platform-feature-flags": "^2.1.1",
    "@atlaskit/primitives": "^22.2.1",
    "@atlaskit/section-message": "^10.0.0",
    "@atlaskit/spinner": "^20.1.2",
    "@atlaskit/tokens": "^16.4.0",
    "@compiled/react": "^1.0.0",
    "@tanstack/react-query": "5.56.2",
    "@usrp/api-client": "workspace:*",
    "@usrp/auth": "workspace:*",
    "@usrp/design-system": "workspace:^",
    "@usrp/feature-field-ops": "workspace:*",
    "@usrp/feature-identity": "workspace:*",
    "@usrp/i18n": "workspace:*",
    "@usrp/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@atlaskit/eslint-plugin-design-system": "^16.10.0",
    "@compiled/vite-plugin": "2.0.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@usrp/eslint-config": "workspace:*",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "typescript": "~5.4.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12",
    "workbox-build": "7.4.1"
  }
}
