{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.medical",
  "title": "Medical station",
  "audience": "field-officer",
  "owner": "packages/features/field-ops",
  "purpose": "The agency medical mode from the session: RDF board verdict FIT or UNFIT, RNP and RCS certificate with the physician name.",
  "routes": [
    {
      "path": "/medical",
      "app": "field-station",
      "source": "packages/features/field-ops/src/routes/medical.tsx",
      "role": "station"
    }
  ],
  "operations": [
    "recordMedicalReview"
  ],
  "ads": [
    {
      "name": "TextField",
      "source": "packages/features/field-ops/src/routes/medical.tsx",
      "import": "@atlaskit/textfield"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/field-ops/src/routes/medical.tsx",
      "import": "@atlaskit/section-message"
    }
  ],
  "states": [
    {
      "surface": "medical",
      "required": [
        "no-mode",
        "choose",
        "recorded",
        "refused",
        "offline"
      ],
      "source": "packages/features/field-ops/src/routes/medical.tsx",
      "evidence": [
        "medical-no-mode",
        "medical-outcome",
        "medicalModeFor"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "every field has a programmatic label",
    "interactive targets are at least 48 px"
  ],
  "tests": [
    "apps/field-station/e2e/field-stations.spec.ts",
    "packages/features/field-ops/src/model/medical.test.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/field-station/e2e/field-stations.spec.ts"
      ]
    }
  }
}
