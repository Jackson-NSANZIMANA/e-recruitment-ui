{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.physical",
  "title": "Physical test",
  "audience": "field-officer",
  "owner": "packages/features/field-ops",
  "purpose": "Single-candidate physical capture written to the device ledger first, signed with the device key and sent once; the screen reports the per-record server answer, never \"saved\" on a bare HTTP 200.",
  "routes": [
    {
      "path": "/physical",
      "app": "field-station",
      "source": "packages/features/field-ops/src/routes/physical.tsx",
      "role": "station"
    }
  ],
  "operations": [
    "syncFieldScores"
  ],
  "ads": [
    {
      "name": "TextField",
      "source": "packages/features/field-ops/src/routes/physical.tsx",
      "import": "@atlaskit/textfield"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/field-ops/src/routes/physical.tsx",
      "import": "@atlaskit/section-message"
    }
  ],
  "states": [
    {
      "surface": "physical",
      "required": [
        "blocked",
        "offline",
        "acknowledged",
        "waiting",
        "refused",
        "conflict"
      ],
      "source": "packages/features/field-ops/src/routes/physical.tsx",
      "evidence": [
        "physical-blocked",
        "physical-offline",
        "physical-outcome",
        "physical-paper-prompt",
        "fateOf"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "every field has a programmatic label",
    "interactive targets are at least 48 px"
  ],
  "tests": [
    "apps/field-station/e2e/field-stations.spec.ts",
    "packages/features/field-ops/src/model/field-sync.test.ts",
    "packages/features/field-ops/src/model/physical.test.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/field-station/e2e/field-stations.spec.ts"
      ]
    }
  }
}
