{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "officer.staff",
  "title": "Staff administration",
  "audience": "officer",
  "owner": "packages/features/identity",
  "purpose": "Agency administrators create officers, assign posts with a reason, disable or enable accounts, revoke sessions and, as a second administrator, release a pending officer's one-time activation code. The creating administrator never sees the code.",
  "routes": [
    {
      "path": "/staff",
      "app": "officer-console",
      "source": "packages/features/identity/src/routes/staff.tsx",
      "role": "admin"
    }
  ],
  "operations": [
    "listOfficers",
    "createOfficer",
    "reissueOfficerActivation",
    "assignOfficerPosts",
    "disableOfficer",
    "enableOfficer",
    "revokeOfficerSessions"
  ],
  "ads": [
    {
      "name": "DynamicTable",
      "source": "packages/features/identity/src/ui/StaffPage.tsx",
      "import": "@atlaskit/dynamic-table"
    },
    {
      "name": "Select",
      "source": "packages/features/identity/src/ui/StaffPage.tsx",
      "import": "@atlaskit/select"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/identity/src/ui/StaffPage.tsx",
      "import": "@atlaskit/section-message"
    },
    {
      "name": "ConfirmAction",
      "source": "packages/features/identity/src/ui/StaffPage.tsx",
      "import": "@usrp/ui"
    },
    {
      "name": "ModalDialog",
      "source": "packages/features/identity/src/ui/ReleaseDialog.tsx",
      "import": "@atlaskit/modal-dialog"
    }
  ],
  "states": [
    {
      "surface": "list",
      "required": [
        "loading",
        "populated",
        "empty",
        "forbidden",
        "error"
      ],
      "source": "packages/features/identity/src/ui/StaffPage.tsx",
      "evidence": [
        "listState",
        "StateBoundary",
        "officer.read",
        "staff-table"
      ]
    },
    {
      "surface": "actions",
      "required": [
        "idle",
        "pending",
        "success",
        "failure",
        "conflict"
      ],
      "source": "packages/features/identity/src/ui/StaffPage.tsx",
      "evidence": [
        "ConfirmAction",
        "staff-refusal",
        "staff-notice",
        "identity.staff.refusals"
      ]
    },
    {
      "surface": "release",
      "required": [
        "idle",
        "pending",
        "success",
        "failure"
      ],
      "source": "packages/features/identity/src/ui/ReleaseDialog.tsx",
      "evidence": [
        "activation-code",
        "identity.release.onceTitle",
        "activationSheetHtml"
      ]
    }
  ],
  "accessibility": [
    "each row action names its officer",
    "every action states its consequence before confirmation",
    "the own row is read-only",
    "the activation code is shown once with copy and print",
    "all user-facing text is translated"
  ],
  "tests": [
    "apps/officer-console/e2e/staff-admin.spec.ts",
    "packages/features/identity/src/model/staff.test.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/officer-console/e2e/staff-admin.spec.ts"
      ],
      "contract": "29f34aa53bc94b3ae246ca82fcad8310404afe98"
    }
  }
}
