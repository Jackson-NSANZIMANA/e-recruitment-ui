{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.setup",
  "title": "Device setup",
  "audience": "field-officer",
  "owner": "packages/features/field-ops",
  "purpose": "Check the tablet, confirm the venue day against the roster and enrol the device with its non-extractable key. A failed check blocks the stations and points to paper.",
  "routes": [
    {
      "path": "/setup",
      "app": "field-station",
      "source": "packages/features/field-ops/src/routes/setup.tsx",
      "role": "station"
    }
  ],
  "operations": [
    "enrollFieldDevice",
    "getVenueRoster"
  ],
  "ads": [
    {
      "name": "TextField",
      "source": "packages/features/field-ops/src/routes/setup.tsx",
      "import": "@atlaskit/textfield"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/field-ops/src/routes/setup.tsx",
      "import": "@atlaskit/section-message"
    },
    {
      "name": "LoadingButton",
      "source": "packages/features/field-ops/src/routes/setup.tsx",
      "import": "@atlaskit/button/loading-button"
    }
  ],
  "states": [
    {
      "surface": "setup",
      "required": [
        "runtime-failed",
        "blocked",
        "ready",
        "venue-failed",
        "enrolled",
        "enrol-failed"
      ],
      "source": "packages/features/field-ops/src/routes/setup.tsx",
      "evidence": [
        "setup-runtime-failed",
        "setup-blocked",
        "setup-ready",
        "setup-venue-failed",
        "setup-enrolled",
        "setup-enrol-failed"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "every field has a programmatic label",
    "interactive targets are at least 48 px"
  ],
  "tests": [
    "apps/field-station/e2e/field-stations.spec.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/field-station/e2e/field-stations.spec.ts"
      ]
    }
  }
}
