{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.sign-in",
  "title": "Field Station sign-in",
  "audience": "field-officer",
  "owner": "packages/features/identity",
  "purpose": "Officer sign-in on the exam-day tablet, landing on the station picker. Same implementation as the console (ADR-FE-007 §5).",
  "routes": [
    {
      "path": "/login",
      "app": "field-station",
      "source": "packages/features/identity/src/routes/officer-login.tsx",
      "role": "sign-in"
    }
  ],
  "operations": [
    "officerLogin",
    "readSession"
  ],
  "ads": [
    {
      "name": "Form",
      "source": "packages/features/identity/src/routes/officer-login.tsx",
      "import": "@atlaskit/form"
    },
    {
      "name": "TextField",
      "source": "packages/features/identity/src/routes/officer-login.tsx",
      "import": "@atlaskit/textfield"
    }
  ],
  "states": [
    {
      "surface": "sign-in",
      "required": [
        "idle",
        "submitting",
        "refused",
        "authenticated"
      ],
      "source": "packages/features/identity/src/routes/officer-login.tsx",
      "evidence": [
        "serverError",
        "submitting",
        "authenticated"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "every field has a programmatic label"
  ],
  "tests": [
    "apps/field-station/e2e/stations.spec.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/field-station/e2e/stations.spec.ts"
      ]
    }
  }
}
