{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "officer.activate",
  "title": "Officer activation",
  "audience": "officer",
  "owner": "packages/features/identity",
  "purpose": "A new officer redeems the one-time activation code a second administrator gave them and chooses their own password. Every failure is one answer.",
  "routes": [
    {
      "path": "/activate",
      "app": "officer-console",
      "source": "packages/features/identity/src/routes/activate.tsx",
      "role": "form"
    }
  ],
  "operations": [
    "activateOfficer"
  ],
  "ads": [
    {
      "name": "TextField",
      "source": "packages/features/identity/src/ui/ActivatePage.tsx",
      "import": "@atlaskit/textfield"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/identity/src/ui/ActivatePage.tsx",
      "import": "@atlaskit/section-message"
    },
    {
      "name": "Heading",
      "source": "packages/features/identity/src/ui/ActivatePage.tsx",
      "import": "@atlaskit/heading"
    }
  ],
  "states": [
    {
      "surface": "form",
      "required": [
        "idle",
        "pending",
        "success",
        "failure"
      ],
      "source": "packages/features/identity/src/ui/ActivatePage.tsx",
      "evidence": [
        "activate-done",
        "activate-rejected",
        "passwordProblem",
        "identity.activate.weak"
      ]
    }
  ],
  "accessibility": [
    "every field has a programmatic label",
    "a wrong code gives the same message as a wrong handle",
    "all user-facing text is translated"
  ],
  "tests": [
    "apps/officer-console/e2e/staff-admin.spec.ts",
    "packages/features/identity/src/model/staff.test.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/officer-console/e2e/staff-admin.spec.ts"
      ],
      "contract": "cd4962842e26177f179eb3c0bd51c214dad3fd61"
    }
  }
}
