{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "officer.application-workspace",
  "title": "Officer application workspace",
  "audience": "officer",
  "owner": "packages/features/applications",
  "purpose": "Let an agency officer find, inspect (Applicant 360) and take an authorised action on applications without losing status, history, or error context.",
  "routes": [
    {
      "path": "/applications",
      "app": "officer-console",
      "source": "packages/features/applications/src/routes/list.tsx",
      "role": "list"
    },
    {
      "path": "/applications/:id",
      "app": "officer-console",
      "source": "packages/features/applications/src/routes/detail.tsx",
      "role": "detail"
    }
  ],
  "operations": [
    "searchApplications",
    "getApplicationDetail",
    "getDocumentChecklist",
    "getBiometricEvidence",
    "recordMedicalReview",
    "recordFinalDecision",
    "acceptApplication",
    "adjudicateApplication"
  ],
  "ads": [
    {
      "name": "Heading",
      "source": "packages/features/applications/src/ui/ApplicationsPage.tsx",
      "import": "@atlaskit/heading"
    },
    {
      "name": "Select",
      "source": "packages/features/applications/src/ui/ApplicationsPage.tsx",
      "import": "@atlaskit/select"
    },
    {
      "name": "Textfield",
      "source": "packages/features/applications/src/ui/ApplicationsPage.tsx",
      "import": "@atlaskit/textfield"
    },
    {
      "name": "Tabs",
      "source": "packages/features/applications/src/ui/ApplicationDetailPage.tsx",
      "import": "@atlaskit/tabs"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/applications/src/ui/ApplicationDetailPage.tsx",
      "import": "@atlaskit/section-message"
    },
    {
      "name": "ConfirmAction",
      "source": "packages/features/applications/src/ui/ActionPanels.tsx",
      "import": "@usrp/ui"
    },
    {
      "name": "StatusLozenge",
      "source": "packages/features/applications/src/ui/ApplicationDetailPage.tsx",
      "import": "./StatusLozenge.js"
    }
  ],
  "states": [
    {
      "surface": "list",
      "required": [
        "loading",
        "populated",
        "empty",
        "filtered-empty",
        "error"
      ],
      "source": "packages/features/applications/src/ui/ApplicationsPage.tsx",
      "evidence": [
        "listState",
        "StateBoundary",
        "onClearFilters",
        "applications.list.total"
      ]
    },
    {
      "surface": "detail",
      "required": [
        "loading",
        "populated",
        "not-found",
        "forbidden",
        "partial"
      ],
      "source": "packages/features/applications/src/ui/ApplicationDetailPage.tsx",
      "evidence": [
        "StateBoundary",
        "stateFromHttpStatus",
        "blocked-by-post",
        "useOfficerSession"
      ]
    },
    {
      "surface": "actions",
      "required": [
        "idle",
        "pending",
        "success",
        "failure",
        "conflict"
      ],
      "source": "packages/features/applications/src/ui/ActionPanels.tsx",
      "evidence": [
        "isPending",
        "ConfirmAction",
        "CROSS_AGENCY_LOCKED",
        "RefusalMessage"
      ]
    }
  ],
  "accessibility": [
    "search filters have programmatic labels",
    "status is not communicated by colour alone",
    "every transition goes through a confirmation that states its consequence",
    "biometric evidence is labelled advisory and never rendered as a verdict",
    "all user-facing text is translated"
  ],
  "tests": [
    "apps/officer-console/e2e/application-workspace.spec.ts",
    "packages/features/applications/src/model/workspace.test.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/officer-console/e2e/application-workspace.spec.ts"
      ],
      "contract": "cd4962842e26177f179eb3c0bd51c214dad3fd61"
    }
  }
}
