{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.check-in",
  "title": "Biometric check-in",
  "audience": "field-officer",
  "owner": "packages/features/field-ops",
  "purpose": "Biometric policy notice (ADR-037): evidence only. In SHADOW nothing about a face is shown and a no-match is never a refusal. Capture itself is B2.",
  "routes": [
    {
      "path": "/check-in",
      "app": "field-station",
      "source": "packages/features/field-ops/src/routes/check-in.tsx",
      "role": "station"
    }
  ],
  "operations": [
    "getBiometricPolicy"
  ],
  "ads": [
    {
      "name": "Lozenge",
      "source": "packages/features/field-ops/src/routes/check-in.tsx",
      "import": "@atlaskit/lozenge"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/field-ops/src/routes/check-in.tsx",
      "import": "@atlaskit/section-message"
    }
  ],
  "states": [
    {
      "surface": "check-in",
      "required": [
        "loading",
        "mode",
        "failed"
      ],
      "source": "packages/features/field-ops/src/routes/check-in.tsx",
      "evidence": [
        "check-in-failed",
        "check-in-mode"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "every field has a programmatic label",
    "interactive targets are at least 48 px"
  ],
  "tests": [
    "apps/field-station/e2e/field-stations.spec.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/field-station/e2e/field-stations.spec.ts"
      ]
    }
  }
}
