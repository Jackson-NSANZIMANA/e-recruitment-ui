{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.check-in",
  "title": "Biometric check-in",
  "audience": "field-officer",
  "owner": "packages/features/field-ops",
  "purpose": "Biometric check-in at the venue. verifyBiometric is unserved (upstream unverified); B1 and B2 own it.",
  "routes": [
    {
      "path": "/check-in",
      "app": "field-station",
      "source": "packages/features/field-ops/src/routes/check-in.tsx",
      "role": "station"
    }
  ],
  "operations": [],
  "ads": [],
  "states": [],
  "accessibility": [],
  "tests": [
    "apps/field-station/e2e/stations.spec.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "DECLARED",
    "blockedBy": [
      "B1",
      "B2"
    ]
  }
}
