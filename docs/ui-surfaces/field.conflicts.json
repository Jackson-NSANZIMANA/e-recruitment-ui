{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "field.conflicts",
  "title": "Capture conflicts",
  "audience": "field-officer",
  "owner": "packages/features/field-ops",
  "purpose": "The supervisor resolves a score the server holds: this device's signed capture is shown, a reason is mandatory, and only a 200 RESOLVED moves the record.",
  "routes": [
    {
      "path": "/conflicts",
      "app": "field-station",
      "source": "packages/features/field-ops/src/routes/conflicts.tsx",
      "role": "station"
    }
  ],
  "operations": [
    "resolveFieldSyncConflict"
  ],
  "ads": [
    {
      "name": "TextField",
      "source": "packages/features/field-ops/src/routes/conflicts.tsx",
      "import": "@atlaskit/textfield"
    },
    {
      "name": "SectionMessage",
      "source": "packages/features/field-ops/src/routes/conflicts.tsx",
      "import": "@atlaskit/section-message"
    }
  ],
  "states": [
    {
      "surface": "conflicts",
      "required": [
        "none",
        "held",
        "reason-required",
        "failed",
        "resolved"
      ],
      "source": "packages/features/field-ops/src/routes/conflicts.tsx",
      "evidence": [
        "conflicts-no-permission",
        "conflicts-none",
        "conflict-failed-",
        "readResolveAnswer"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "every field has a programmatic label",
    "interactive targets are at least 48 px"
  ],
  "tests": [
    "apps/field-station/e2e/field-stations.spec.ts",
    "packages/features/field-ops/src/model/resolve.test.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/field-station/e2e/field-stations.spec.ts"
      ]
    }
  }
}
