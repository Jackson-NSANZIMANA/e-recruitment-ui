{
  "$schema": "../../tooling/surface-contract/surface-contract.schema.json",
  "schemaVersion": 2,
  "id": "officer.dashboard",
  "title": "Officer dashboard and administration",
  "audience": "officer",
  "owner": "apps/officer-console",
  "purpose": "Exception-first landing page. Case-working posts see the counts they act on; posts that run the agency (campaigns, staff, fleet) see what requires attention, then campaigns with occupancy, applications by stage, staff and field tablets.",
  "routes": [
    {
      "path": "/dashboard",
      "app": "officer-console",
      "source": "apps/officer-console/src/routes/dashboard.tsx",
      "role": "dashboard"
    }
  ],
  "operations": [
    "listApplications",
    "listAmberQueue",
    "listAgencyCampaigns",
    "searchApplications",
    "listOfficers",
    "listFieldDevices"
  ],
  "ads": [
    {
      "name": "PageHeader",
      "source": "apps/officer-console/src/routes/dashboard.tsx",
      "import": "@atlaskit/page-header"
    },
    {
      "name": "SectionMessage",
      "source": "apps/officer-console/src/routes/dashboard.tsx",
      "import": "@atlaskit/section-message"
    },
    {
      "name": "DynamicTable",
      "source": "apps/officer-console/src/dashboard/panels.tsx",
      "import": "@atlaskit/dynamic-table"
    },
    {
      "name": "Lozenge",
      "source": "apps/officer-console/src/dashboard/panels.tsx",
      "import": "@atlaskit/lozenge"
    }
  ],
  "states": [
    {
      "surface": "dashboard",
      "required": [
        "loading",
        "populated",
        "no-exceptions",
        "error"
      ],
      "source": "apps/officer-console/src/routes/dashboard.tsx",
      "evidence": [
        "isLoading",
        "isError",
        "requiresAction"
      ]
    },
    {
      "surface": "administration",
      "required": [
        "loading",
        "populated",
        "no-exceptions",
        "partial",
        "error"
      ],
      "source": "apps/officer-console/src/routes/dashboard.tsx",
      "evidence": [
        "isLoading",
        "isError",
        "requiresAction",
        "dashboard-partial"
      ]
    }
  ],
  "accessibility": [
    "all user-facing text is translated",
    "status is not communicated by color alone",
    "each panel is a labelled region; meters expose value, maximum and a spoken label"
  ],
  "tests": [
    "apps/officer-console/e2e/application-flow.spec.ts",
    "apps/officer-console/e2e/admin-dashboard.spec.ts"
  ],
  "rules": {
    "browserTransport": "operation-id-only",
    "agencyAuthority": "server-session",
    "pii": "no-national-id-or-hash",
    "interactiveTargetMinimumPx": 48,
    "positivePolarityOnly": true
  },
  "readiness": {
    "rung": "E2E-PROVEN",
    "evidence": {
      "e2e": [
        "apps/officer-console/e2e/application-flow.spec.ts",
        "apps/officer-console/e2e/admin-dashboard.spec.ts"
      ]
    }
  }
}
