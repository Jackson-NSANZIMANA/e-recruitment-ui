{
  "name": "usrp-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Security Recruitment Portal — Frontend Monorepo (RDF/RNP/RCS)",
  "author": "Jackson NSANZIMANA",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c9f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "engines": {
    "node": ">=20 <=25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "storybook": "pnpm --filter @usrp/design-system run storybook",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "scan:cssmap": "turbo run scan:cssmap",
    "a11y": "bash tooling/repo-hygiene/run-storybook-a11y.sh",
    "security:scan": "bash tooling/security/security-scan.sh",
    "security:scan:selftest": "bash tooling/security/security-scan.sh --selftest",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "test:affected": "turbo run test --affected",
    "verify:hygiene": "node tooling/repo-hygiene/verify.mjs",
    "verify:rules": "node tooling/repo-hygiene/test/*.test.mjs",
    "verify:extraction": "node tooling/repo-hygiene/verify-compiled-extraction.mjs",
    "size": "node tooling/repo-hygiene/check-bundle-size.mjs",
    "check:large-files": "node tooling/repo-hygiene/check-large-files.mjs",
    "check:boundaries": "node tooling/repo-hygiene/check-boundaries.mjs",
    "check:script-coverage": "node tooling/repo-hygiene/check-script-coverage.mjs",
    "verify": "pnpm verify:rules && pnpm verify:hygiene && pnpm typecheck && pnpm lint && pnpm test",
    "verify:full": "pnpm verify && pnpm build && pnpm verify:extraction && pnpm size && pnpm a11y && pnpm security:scan",
    "prove:gates": "bash tooling/repo-hygiene/prove-gates.sh",
    "prove:security": "pnpm security:scan:selftest",
    "purge:vendor-zip:dry-run": "bash tooling/repo-hygiene/purge-vendor-zip.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@atlaskit/ads-mcp": "1.7.3",
    "@atlaskit/tokens": "^16.4.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.5.0",
    "@types/react": "18",
    "@types/react-dom": "18",
    "prettier": "3.3.3",
    "turbo": "2.5.4"
  }
}
